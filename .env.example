# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and restart the dev
# server to switch from bundled mock data to the live TMDB API.
# ─────────────────────────────────────────────────────────────

# Your TMDB v3 API key — get one free at:
#   https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=

# Leave "true" (default) for mock data; set to "false" to call live TMDB.
VITE_USE_MOCK=true
