# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and restart the dev
# server. Adding a credential auto-switches the app from bundled
# mock data to the live TMDB API — no code changes needed.
#
# Get credentials free at: https://www.themoviedb.org/settings/api
# ─────────────────────────────────────────────────────────────

# TMDB v4 "read access token" (preferred). Sent as `Authorization: Bearer`.
VITE_TMDB_TOKEN=

# TMDB v3 API key (fallback). Used only when the token above is blank.
VITE_TMDB_KEY=

# Mock-data switch. Leave blank to auto-detect (live when a credential exists).
# Set "true" to force the bundled mock data; "false" to force live.
VITE_USE_MOCK=
